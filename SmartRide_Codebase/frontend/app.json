{
  "expo": {
    "name": "SmartRide AI",
    "slug": "ai-cab-booking",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/app-icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./public/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080C14"
    },
    "android": {
      "package": "com.bhumanarasimha.smartride",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./public/app-icon.png",
        "backgroundColor": "#080C14"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_ANDROID_API_KEY"
        }
      }
    },
    "web": {
      "favicon": "./public/app-icon.png"
    }
  }
}
